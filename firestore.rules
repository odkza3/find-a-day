rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One document per event: its title and group size.
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['title', 'groupSize'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 60
        && request.resource.data.groupSize is int
        && request.resource.data.groupSize >= 2
        && request.resource.data.groupSize <= 100;

      // One document per person: their name and the days they're free.
      match /people/{personId} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if request.resource.data.keys().hasOnly(['name', 'dates', 'updated'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24
          && request.resource.data.dates is list
          && request.resource.data.dates.size() <= 400;
      }
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
